{
  "manifest_version": 2,
  "name": "YBrowser Reader Bridge",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "ybrowser-reader@yagay.com"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "<all_urls>"
  ]
}
