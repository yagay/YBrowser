{
  "manifest_version": 2,
  "name": "YBrowser Reader Bridge",
  "version": "1.0.2",
  "browser_specific_settings": {
    "gecko": {
      "id": "ybrowser-reader@yagay.com"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "privacy",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ]
}
