<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="YBrowser Sample Feature"
        android:allowBackup="false">
        <service
            android:name=".FeatureDescriptorService"
            android:exported="true"
            android:permission="com.yagay.ybrowser.loader.permission.DISCOVER">
            <intent-filter>
                <action android:name="com.yagay.ybrowser.loader.FEATURE" />
            </intent-filter>
            <meta-data
                android:name="ybrowser.feature.class"
                android:value="com.yagay.ybrowser.sample.SampleFeature" />
        </service>
    </application>
</manifest>
